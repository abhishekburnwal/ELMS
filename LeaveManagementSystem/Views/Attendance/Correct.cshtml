@model LeaveManagementSystem.ViewModels.AttendanceCorrectionViewModel
@{
    ViewData["Title"] = "Correct Attendance";
}

<div class="topbar">
    <h1>Correct — @Model.EmployeeName, @Model.Date.ToString("yyyy-MM-dd")</h1>
</div>

<div class="panel">
    <div class="body">
        <form asp-action="Correct" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="RecordId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="field">
                <label asp-for="Status"></label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<LeaveManagementSystem.Models.Enums.AttendanceStatus>()" class="form-control"></select>
            </div>
            <div class="field">
                <label asp-for="WorkingHours">Working Hours</label>
                <input asp-for="WorkingHours" type="number" min="0.5" max="24" step="0.5" class="form-control" />
                <span asp-validation-for="WorkingHours" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="ProjectName">Project Name</label>
                <input asp-for="ProjectName" class="form-control" maxlength="200" />
                <span asp-validation-for="ProjectName" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Remarks"></label>
                <input asp-for="Remarks" class="form-control" maxlength="500" />
            </div>
            <div style="display:flex; gap:10px;">
                <button type="submit" class="btn-elms btn-elms-auto">Save</button>
                <a asp-action="Daily" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" class="btn-elms btn-elms-auto" style="text-decoration:none; background:#fff; color:var(--navy); border:1px solid var(--line);">Cancel</a>
            </div>
        </form>
    </div>
</div>
