@model LeaveManagementSystem.ViewModels.AttendanceHistoryViewModel
@{
    ViewData["Title"] = "Attendance History";
}

<div class="topbar">
    <h1>Attendance History</h1>
</div>

<div class="panel">
    <table class="elms">
        <thead>
            <tr>
                <th>Date</th>
                <th>Day</th>
                <th>Status</th>
                <th>Check In</th>
                <th>Check Out</th>
                <th>Remarks</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Records.Count == 0)
        {
            <tr><td colspan="6" style="color:var(--ink-soft);">No attendance records yet.</td></tr>
        }
        @foreach (var r in Model.Records)
        {
            <tr>
                <td>@r.Date.ToString("yyyy-MM-dd")</td>
                <td>@r.Date.ToString("ddd")</td>
                <td><span class="badge @r.Status.ToString().ToLower()">@r.Status</span></td>
                <td>@(r.CheckIn?.ToString("HH:mm") ?? "—")</td>
                <td>@(r.CheckOut?.ToString("HH:mm") ?? "—")</td>
                <td>@(r.Remarks ?? "—")</td>
            </tr>
        }
        </tbody>
    </table>
</div>
