@model LeaveManagementSystem.ViewModels.AttendanceUpsertViewModel
@{
    ViewData["Title"] = "Manual Attendance Entry";
}

<div class="topbar">
    <h1>Manual Attendance Entry</h1>
</div>

<div class="panel">
    <div class="body">
        <form asp-action="Mark" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="field">
                <label asp-for="UserId">Employee</label>
                <select asp-for="UserId" class="form-control">
                    <option value="">— Select employee —</option>
                    @foreach (var e in (ViewBag.Employees as List<LeaveManagementSystem.Models.Entities.User>) ?? new())
                    {
                        <option value="@e.Id">@e.FullName (@e.Email)</option>
                    }
                </select>
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Date"></label>
                <input asp-for="Date" type="date" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Status"></label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<LeaveManagementSystem.Models.Enums.AttendanceStatus>()" class="form-control"></select>
            </div>
            <div class="field">
                <label asp-for="WorkingHours">Working Hours</label>
                <input asp-for="WorkingHours" type="number" min="0.5" max="24" step="0.5" class="form-control" />
                <span asp-validation-for="WorkingHours" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="ProjectName">Project Name</label>
                <input asp-for="ProjectName" class="form-control" maxlength="200" />
                <span asp-validation-for="ProjectName" class="text-danger"></span>
            </div>
            <div class="field">
                <label asp-for="Remarks"></label>
                <input asp-for="Remarks" class="form-control" maxlength="500" />
            </div>
            <button type="submit" class="btn-elms btn-elms-auto">Save</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
