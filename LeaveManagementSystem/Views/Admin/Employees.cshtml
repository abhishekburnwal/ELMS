@model List<LeaveManagementSystem.ViewModels.EmployeeListItemViewModel>
@{
    ViewData["Title"] = "Employees";
    var search = (string?)ViewData["Search"];
}

<div class="topbar">
    <h1>Employees</h1>
    <span class="who">Signed in as @User.Identity?.Name (Admin)</span>
</div>

<div class="panel">
    <h3>All employees</h3>
    <div class="body" style="border-bottom:1px solid var(--line); display:flex; gap:10px; align-items:center; justify-content:space-between;">
        <form asp-action="Employees" method="get" style="display:flex; gap:8px; flex:1; max-width:420px;">
            <input type="text" name="search" value="@search" placeholder="Search by name or email"
                   style="flex:1; padding:9px 12px; border:1px solid var(--line); border-radius:var(--radius); font-size:14px; font-family:inherit;" />
            <button type="submit" class="btn-elms btn-elms-auto">Search</button>
        </form>
        <a asp-action="CreateEmployee" class="btn-elms btn-elms-auto" style="text-decoration:none; display:inline-block; text-align:center;">Add Employee</a>
    </div>
    <table class="elms">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Status</th>
                <th>Balance</th>
                <th>Used</th>
                <th>Remaining</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="7" style="color:var(--ink-soft);">No employees found.</td></tr>
        }
        @foreach (var e in Model)
        {
            <tr>
                <td>@e.FullName</td>
                <td>@e.Email</td>
                <td>
                    @if (e.IsActive)
                    {
                        <span class="badge approved">Active</span>
                    }
                    else
                    {
                        <span class="badge rejected">Inactive</span>
                    }
                </td>
                <td>@e.LeaveBalance</td>
                <td>@e.UsedDays</td>
                <td>@e.RemainingDays</td>
                <td>
                    <span class="row-actions">
                        <a asp-action="EditEmployee" asp-route-id="@e.Id" style="text-decoration:none;">
                            <button type="button">Edit</button>
                        </a>
                        @if (e.IsActive)
                        {
                            <form asp-action="DeactivateEmployee" asp-route-id="@e.Id" method="post" style="display:inline;"
                                  onsubmit="return confirm('Deactivate @e.FullName? They will no longer be able to sign in. Leave history is preserved.');">
                                <button type="submit" class="reject">Deactivate</button>
                            </form>
                        }
                        else
                        {
                            <form asp-action="ReactivateEmployee" asp-route-id="@e.Id" method="post" style="display:inline;">
                                <button type="submit" class="approve">Reactivate</button>
                            </form>
                        }
                    </span>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
